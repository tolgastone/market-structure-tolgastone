i_fiboL3                = input.float(
    0.236, "Ratio 2", step = 0.001, group = group_FIBO, inline = "L3",
    tooltip = "Editable logarithmic ratio. The adjacent Enable switch controls this level. Ratios are used as entered; they are not sorted or deduplicated.",
    display = display.data_window
)
i_showFiboL4            = input.bool(false, "Enable 3", group = group_FIBO, inline = "L4")
i_fiboL4                = input.float(
    0.382, "Ratio 3", step = 0.001, group = group_FIBO, inline = "L4",
    tooltip = "Editable logarithmic ratio. The adjacent Enable switch controls this level. Ratios are used as entered; they are not sorted or deduplicated.",
    display = display.data_window
)
i_showFiboL5            = input.bool(true, "Enable 4", group = group_FIBO, inline = "L5")
i_fiboL5                = input.float(
    0.5, "Ratio 4", step = 0.001, group = group_FIBO, inline = "L5",
    tooltip = "Editable logarithmic ratio. The adjacent Enable switch controls this level. Ratios are used as entered; they are not sorted or deduplicated.",
    display = display.data_window
)
i_showFiboL6            = input.bool(true, "Enable 5", group = group_FIBO, inline = "L6")
i_fiboL6                = input.float(
    0.618, "Ratio 5", step = 0.001, group = group_FIBO, inline = "L6",
    tooltip = "Editable logarithmic ratio. The adjacent Enable switch controls this level. Ratios are used as entered; they are not sorted or deduplicated.",
    display = display.data_window
)
i_showFiboL7            = input.bool(false, "Enable 6", group = group_FIBO, inline = "L7")
i_fiboL7                = input.float(
    0.700, "Ratio 6", step = 0.001, group = group_FIBO, inline = "L7",
    tooltip = "Editable logarithmic ratio. The adjacent Enable switch controls this level. Ratios are used as entered; they are not sorted or deduplicated.",
    display = display.data_window
)
i_showFiboL8            = input.bool(true, "Enable 7", group = group_FIBO, inline = "L8")
i_fiboL8                = input.float(
    0.786, "Ratio 7", step = 0.001, group = group_FIBO, inline = "L8",
    tooltip = "Editable logarithmic ratio. The adjacent Enable switch controls this level. Ratios are used as entered; they are not sorted or deduplicated.",
    display = display.data_window
)
i_showFiboL9            = input.bool(false, "Enable 8", group = group_FIBO, inline = "L9")
i_fiboL9                = input.float(
    1.272, "Ratio 8", step = 0.001, group = group_FIBO, inline = "L9",
    tooltip = "Editable logarithmic ratio. The adjacent Enable switch controls this level. Ratios are used as entered; they are not sorted or deduplicated.",
    display = display.data_window
