//@version=6
//
// Tracks structural boundary breaks, impulse extremes, and opposite-Cement completion.
// Initial direction uses Cement; an opposite boundary break can interrupt an impulse.
// Open-bar results are provisional. Completed swings can be drawn at earlier extremes.
// Shared for educational and informational use; not financial or investment advice.
// Trading involves risk. No accuracy, profitability or future result is guaranteed.

indicator(
    "Market Structure by tolgastone",
    "MST",
    overlay          = true,
    max_labels_count = 500,
    max_lines_count  = 500,
    max_boxes_count  = 500
)

// =============================================================================
// INPUTS
// =============================================================================
// Input group labels.
var group_APPEARANCE = "Appearance"
var group_STRUCTURAL = "Structure"
var group_VISUAL     = "Structure display"
var group_FIBO       = "Fibonacci"
var group_FVG        = "Fair value gaps"
var group_ZONES      = "Swing Zones"

// Auto follows the chart background; Custom uses the color controls below.
i_colorMode = input.string(
    "Auto", "Color mode", ["Auto", "Custom"], group = group_APPEARANCE,
    tooltip = "Auto adapts colors to the chart background. Custom uses your selected colors. Visibility switches apply in both modes.",
    display = display.data_window
)
i_bullColor = input.color(#087F7A, "Bullish color", group = group_APPEARANCE)
i_bearColor = input.color(#BA4C52, "Bearish color", group = group_APPEARANCE)

// Structural rules.
i_breakSource        = input.string(
    "Close", "Break source", ["Close", "High/Low"], group = group_STRUCTURAL,
    tooltip = "Close uses the current close; High/Low uses candle extremes. Equality is not a break. Open-bar results can change before close.",
    display = display.data_window
)
i_cementLength       = input.int(
    1,
    "Cement lookback bars",
    minval  = 1,
    maxval  = 10,
    step    = 1,
    tooltip = "Number of preceding bars checked by Cement: bullish close above every high, or bearish close below every low. Not a count of consecutive Cement candles.",
    group   = group_STRUCTURAL,
    display = display.data_window
)

// Optional penetration filter. None retains the original strict-crossing behavior.
i_breakTolerance = input.string(
    "None", "Break tolerance", ["None", "Percent", "ATR"], group = group_STRUCTURAL,
    tooltip = "Require extra distance beyond the reference high/low for both normal breaks and opposite-boundary interruptions. None preserves the original rules. Cement is unchanged.",
    display = display.data_window
)
i_breakPercent = input.float(
    0.5, "Break tolerance (%)", minval = 0.0, maxval = 99.0, step = 0.1, group = group_STRUCTURAL,
    tooltip = "Percent mode only. Distance = absolute reference boundary price x percentage / 100. A value of 0 disables the filter. Equality at the threshold is not a break.",
    display = display.data_window
)
i_breakAtrLength = input.int(
    14, "Break ATR length", minval = 1, maxval = 500, group = group_STRUCTURAL,
    tooltip = "ATR mode only. Uses the previous closed bar's Wilder ATR on the chart timeframe. The distance is recalculated each bar, not frozen per swing.",
    display = display.data_window
)
i_breakAtrMultiplier = input.float(
    0.1, "Break ATR multiplier", minval = 0.0, maxval = 100.0, step = 0.05, group = group_STRUCTURAL,
    tooltip = "ATR mode only. Distance = previous closed-bar ATR x multiplier. No filtered break is accepted until ATR is available. A value of 0 disables the filter.",
    display = display.data_window
)

// Optional Fibonacci ratios; levels 0 and 1 are included by the display code.
i_showFiboL2            = input.bool(false, "Enable 1", group = group_FIBO, inline = "L2")
i_fiboL2                = input.float(
    -0.272, "Ratio 1", step = 0.001, group = group_FIBO, inline = "L2",
