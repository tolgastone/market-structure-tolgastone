// Display switches and colors.
i_showFilteredBreaks = input.bool(
    false, "Filtered break markers (T)", group = group_VISUAL,
    tooltip = "T marks a tested boundary crossing that did not exceed the tolerance threshold. Uses the selected break source, not wick-only sweep detection. Open-bar marks can change; repeated bars may each be marked."
)
i_showCements           = input.bool(
    false, "Cement markers", group = group_VISUAL,
    tooltip = "Show opposite-Cement completion markers. Hiding markers does not disable Cement calculations."
)
i_showBreaks            = input.bool(
    true, "BOS / CHoCH labels", group = group_VISUAL,
    tooltip = "Show structural break lines and BOS/CHoCH labels. Labels are centered along the line; their position is not the event time."
)
i_showHighLows          = input.bool(
    true, "Swing extreme markers", group = group_VISUAL,
    tooltip = "Mark swing extremes at their original bars when a swing is drawn on completion or interruption."
)
i_showFibo              = input.bool(
    true, "Show Fibonacci levels", group = group_FIBO,
    tooltip = "Show logarithmic Fibonacci levels on the working swing. Levels 0 and 1 are always included; 0.5 is the geometric midpoint."
)
i_showCurrentBreakLines = input.bool(
    true, "Working swing boundaries", group = group_VISUAL,
    tooltip = "Show the working swing high and low. Break detection uses the reference swing, so these arrows can differ from the active break thresholds."
)
i_showFvgs              = input.bool(
    false, "Show FVG fragments", group = group_FVG,
    tooltip = "Show surviving gap fragments within the reference swing display range. Candle ranges can trim or split gaps. Tracking continues when hidden."
)
i_lineColor             = input.color(#4773A8, "Structure line color", group = group_VISUAL)
i_fiboColor             = input.color(
    color.new(#64748B, 20), "Fibonacci color", group = group_FIBO,
    tooltip = "Color for Fibonacci lines and text in Custom mode. Boundary arrows have a separate color."
)
i_fvgDownColor          = input.color(color.new(#BA4C52, 90), "Bearish fragment color", group = group_FVG)
i_fvgUpColor            = input.color(color.new(#087F7A, 90), "Bullish fragment color", group = group_FVG)
i_boundaryColor = input.color(color.new(#4773A8, 40), "Boundary color", group = group_VISUAL)

i_lineWidth             = input.int(1, title = "Structure line width", minval = 1, maxval = 5, step = 1, group = group_VISUAL, display = display.data_window)

// Swing Zones are independent of the classic editable Fibonacci levels.
i_showPremiumDiscount = input.bool(
    true, "Premium / Discount", group = group_ZONES,
    tooltip = "Shade prices above/below the working swing geometric midpoint. Follows the working swing, including provisional open-bar updates."
)
i_showEquilibrium = input.bool(true, "Equilibrium (0.5)", group = group_ZONES)
i_showOTE = input.bool(
    true, "OTE zone (0.618–0.786)", group = group_ZONES,
    tooltip = "Logarithmic retracement band: Discount for an UP swing, Premium for a DOWN swing. Independent of the editable Fibonacci ratios."
)
i_oteReference = input.string(
    "0.700", "OTE reference", ["Off", "0.700", "0.705"], group = group_ZONES,
    tooltip = "Optional dotted reference inside the OTE band. Shown only when OTE is enabled.",
    display = display.data_window
)
i_premiumColor = input.color(color.new(#BA4C52, 95), "Premium fill", group = group_ZONES)
i_discountColor = input.color(color.new(#087F7A, 95), "Discount fill", group = group_ZONES)
i_oteColor = input.color(color.new(#7760AA, 84), "OTE fill", group = group_ZONES)
i_equilibriumColor = input.color(#64748B, "Equilibrium color", group = group_ZONES)

// =============================================================================
// THEME-AWARE DISPLAY COLORS
// =============================================================================
// Chart-background brightness also accommodates custom light/dark chart backgrounds.
isLightBackground = (color.r(chart.bg_color) + color.g(chart.bg_color) + color.b(chart.bg_color)) > 382.5
useAutoColors     = i_colorMode == "Auto"

structureColor = useAutoColors ? (isLightBackground ? #4773A8 : #7EA6D8) : i_lineColor
bullColor      = useAutoColors ? (isLightBackground ? #087F7A : #45B8AD) : i_bullColor
bearColor      = useAutoColors ? (isLightBackground ? #BA4C52 : #E48689) : i_bearColor
fiboColor      = useAutoColors ? color.new(isLightBackground ? #64748B : #A1ACBE, 20) : i_fiboColor
fiboTextColor  = useAutoColors and not isLightBackground ? #CBD5E1 : fiboColor
boundaryColor  = useAutoColors ? color.new(structureColor, 40) : i_boundaryColor
fvgUpColor     = useAutoColors ? color.new(bullColor, isLightBackground ? 90 : 87) : i_fvgUpColor
fvgDownColor   = useAutoColors ? color.new(bearColor, isLightBackground ? 90 : 87) : i_fvgDownColor

premiumFillColor = useAutoColors ? color.new(bearColor, isLightBackground ? 95 : 94) : i_premiumColor
discountFillColor = useAutoColors ? color.new(bullColor, isLightBackground ? 95 : 94) : i_discountColor
oteFillColor = useAutoColors ? color.new(isLightBackground ? #7760AA : #B9A4DF, isLightBackground ? 84 : 82) : i_oteColor
equilibriumColor = useAutoColors ? (isLightBackground ? #64748B : #CBD5E1) : i_equilibriumColor
zoneTextColor = useAutoColors ? chart.fg_color : i_equilibriumColor
oteReferenceColor = color.new(oteFillColor, 20)

// =============================================================================
// DATA TYPES
// =============================================================================
enum State
    LOOK_FOR_DIRECTION = "Look for First Direction"
    LOOK_FOR_SWING     = "Look for Swing"
    LOOK_FOR_BREAK     = "Look For Break Up or Down"

enum Direction
    UP   = "Up"
    DOWN = "Down"

type Point
    int   myIndex
    float myLow
    float myHigh
    float myOpen
    float myClose

type CementCandle
    Direction direction
    Point     myPoint

type Swing
    Direction    direction
    Point        swingHigh
    Point        swingLow
    CementCandle cement

type Fvg
    Direction direction
    int       index
    float     myLow
    float     myHigh
    bool      isFilled = false

// =============================================================================
// STRUCTURAL BOUNDARIES
// =============================================================================
// Calculate ATR on every bar; the breaking candle cannot enlarge its own buffer.
breakATR = ta.atr(i_breakAtrLength)[1]
toleranceActive = (i_breakTolerance == "Percent" and i_breakPercent > 0) or (i_breakTolerance == "ATR" and i_breakAtrMultiplier > 0)

get_break_buffer(float boundary) =>
    float distance = 0.0
    if toleranceActive
        distance := i_breakTolerance == "Percent" ? math.abs(boundary) * i_breakPercent / 100.0 : breakATR * i_breakAtrMultiplier
    distance

// Equality is a touch, not a break, including equality at a filtered threshold.
// Close selects the current price source; it does not wait for bar close.
is_break_up(Swing s, string source) =>
    result = false
    if not na(s)
        float buffer = get_break_buffer(s.swingHigh.myHigh)
        result := not na(buffer) and (source == "Close" ? close : high) > s.swingHigh.myHigh + buffer
    result

is_break_down(Swing s, string source) =>
    result = false
    if not na(s)
        float buffer = get_break_buffer(s.swingLow.myLow)
        result := not na(buffer) and (source == "Close" ? close : low) < s.swingLow.myLow - buffer
    result

// Observe only checks the engine actually makes. No candidate or sweep state is created.
is_filtered_break(Swing s, string source, bool upward) =>
    bool result = false
    if toleranceActive and not na(s)
        float boundary = upward ? s.swingHigh.myHigh : s.swingLow.myLow
        float buffer = get_break_buffer(boundary)
        float price = source == "Close" ? close : (upward ? high : low)
        if not na(buffer)
            result := upward ? (price > boundary and price <= boundary + buffer) : (price < boundary and price >= boundary - buffer)
    result

// =============================================================================
// LOGARITHMIC DISPLAY RANGE
// =============================================================================
// Expand the reference swing by its log-price range in both directions.
get_swing_range_double_log(Swing s) =>
    swingHighLog = math.log(s.swingHigh.myHigh)
    swingLowLog  = math.log(s.swingLow.myLow)
    swingRange   = swingHighLog - swingLowLog
    fvgRangeHigh = math.exp(swingHighLog + swingRange)
    fvgRangeLow  = math.exp(swingLowLog - swingRange)
    [fvgRangeHigh, fvgRangeLow]

// =============================================================================
// SWING ZONE DRAWING HELPERS
// =============================================================================
// Match the existing logarithmic Fibonacci formulas without changing swing state.
get_zone_level(Swing s, float ratio) =>
    float logHigh = math.log(s.swingHigh.myHigh)
    float logLow = math.log(s.swingLow.myLow)
    s.direction == Direction.UP ? math.exp(logHigh - (logHigh - logLow) * ratio) : math.exp(logLow + (logHigh - logLow) * ratio)

// Dedicated annotations replace matching classic levels to avoid stacked labels.
zone_owns_ratio(float ratio, bool validSwing) =>
    float reference = i_oteReference == "0.705" ? 0.705 : 0.700
    bool ownsEquilibrium = i_showEquilibrium and ratio == 0.5
    bool ownsOTE = i_showOTE and (ratio == 0.618 or ratio == 0.786 or (i_oteReference != "Off" and ratio == reference))
    validSwing and (ownsEquilibrium or ownsOTE)

// Reuse a bounded set of objects; recreate a handle if platform GC removed it.
update_zone_box(box existing, int leftBar, int rightBar, float topPrice, float bottomPrice, color fillColor) =>
    box result = existing
    if na(result) or not array.includes(box.all, result)
        result := box.new(leftBar, topPrice, rightBar, bottomPrice, border_width = 0, bgcolor = fillColor)
    else
        box.set_lefttop(result, leftBar, topPrice)
        box.set_rightbottom(result, rightBar, bottomPrice)
        box.set_bgcolor(result, fillColor)
    result

update_zone_line(line existing, int leftBar, int rightBar, float price, color lineColor, string lineStyle) =>
    line result = existing
    if na(result) or not array.includes(line.all, result)
        result := line.new(leftBar, price, rightBar, price, color = lineColor, style = lineStyle, width = 1)
    else
        line.set_xy1(result, leftBar, price)
        line.set_xy2(result, rightBar, price)
        line.set_color(result, lineColor)
        line.set_style(result, lineStyle)
    result

update_zone_label(label existing, int labelBar, float price, string labelText, color textColor) =>
    label result = existing
    if na(result) or not array.includes(label.all, result)
        result := label.new(
            labelBar, price, labelText, style = label.style_label_left,
            color = color.new(color.black, 100), textcolor = textColor, size = size.small
        )
    else
        label.set_xy(result, labelBar, price)
        label.set_text(result, labelText)
        label.set_textcolor(result, textColor)
    result

// =============================================================================
// DRAWING HELPERS
// =============================================================================
// Display surviving fragments from the current bar; stored gaps are maintained separately.
draw_fvgs(Fvg[] fvgArr, box[] fvgBoxes, float fvgRangeHigh, float fvgRangeLow, color fvgUpColor, color fvgDownColor) =>
    for fvgBox in fvgBoxes
        fvgBox.delete()
    fvgBoxes.clear()

    for fvg in fvgArr
        if fvg.myHigh <= fvgRangeHigh and fvg.myLow > fvgRangeLow
            fvgBoxes.push(
                box.new(
                    bar_index,
                    top          = fvg.myHigh,
                    right        = bar_index + 30,
                    bottom       = fvg.myLow,
                    bgcolor      = fvg.direction == Direction.DOWN ? fvgDownColor : fvgUpColor,
                    border_width = 0
                )
            )

// Fibonacci levels use logarithmic prices, not linear interpolation.
draw_swing_fibo(Swing s, line[] fiboLines, label[] fiboLabels, float[] fiboLevels, color fiboColor, color fiboTextColor) =>
    for i = 0 to (array.size(fiboLines) == 0 ? na : array.size(fiboLines) - 1)
        fiboLines.get(i).delete()
    for i = 0 to (array.size(fiboLabels) == 0 ? na : array.size(fiboLabels) - 1)
        fiboLabels.get(i).delete()
    fiboLines.clear()
    fiboLabels.clear()

    if s.direction == Direction.UP
        for i = 0 to array.size(fiboLevels) - 1
            fiboVal = math.exp(
                math.log(s.swingHigh.myHigh) - (math.log(s.swingHigh.myHigh) - math.log(s.swingLow.myLow)) * fiboLevels.get(i)
            )
            fiboLabels.push(
                label.new(
                    bar_index + 9,
                    fiboVal,
                    str.tostring(fiboLevels.get(i), '0.000') + " (" + str.tostring(fiboVal, format.mintick) + ")",
                    color     = color.new(color.white, 100),
                    style     = label.style_label_left,
                    textcolor = fiboTextColor,
                    size      = size.small
                )
            )
            fiboLines.push(
                line.new(
                    s.swingHigh.myIndex,
                    fiboVal,
                    bar_index + 10,
                    fiboVal,
                    width = 1,
                    style = line.style_dotted,
                    color = fiboColor
                )
            )
    else
        for i = 0 to array.size(fiboLevels) - 1
            fiboVal = math.exp(
                math.log(s.swingLow.myLow) - (math.log(s.swingLow.myLow) - math.log(s.swingHigh.myHigh)) * fiboLevels.get(i)
            )
            fiboLabels.push(
                label.new(
                    bar_index + 9,
                    fiboVal,
                    str.tostring(fiboLevels.get(i), '0.000') + " (" + str.tostring(fiboVal, format.mintick) + ")",
                    color     = color.new(color.white, 100),
                    style     = label.style_label_left,
                    textcolor = fiboTextColor,
                    size      = size.small
                )
            )
            fiboLines.push(
                line.new(
                    s.swingLow.myIndex,
                    fiboVal,
                    bar_index + 10,
                    fiboVal,
                    width = 1,
                    style = line.style_dotted,
                    color = fiboColor
                )
            )

draw_swing_limit_lines(Swing s, line[] lines, color lineColor) =>
    for i = 0 to (array.size(lines) == 0 ? na : array.size(lines) - 1)
        lines.get(i).delete()
    lines.clear()
    lines.push(
        line.new(
            s.swingHigh.myIndex,
            s.swingHigh.myHigh,
            bar_index + 10,
            s.swingHigh.myHigh,
            width = 1,
            style = line.style_arrow_right,
            color = lineColor
        )
    )
    lines.push(
        line.new(
            s.swingLow.myIndex,
            s.swingLow.myLow,
            bar_index + 10,
            s.swingLow.myLow,
            width = 1,
            style = line.style_arrow_right,
            color = lineColor
        )
    )

draw_cement_point(CementCandle candle) =>
    label.new(
        bar_index,
        candle.direction == Direction.DOWN ? candle.myPoint.myLow : candle.myPoint.myHigh,
        style = candle.direction == Direction.DOWN ? label.style_triangledown : label.style_triangleup,
        color = candle.direction == Direction.DOWN ? bearColor : bullColor,
        size  = 2,
        yloc  = candle.direction == Direction.DOWN ? yloc.belowbar : yloc.abovebar
    )

draw_swing_high_point(Swing s) =>
    label.new(
        s.swingHigh.myIndex,
        s.swingHigh.myHigh,
        style = label.style_circle,
        color = bullColor,
        size  = 2,
        yloc  = yloc.abovebar
    )

draw_swing_low_point(Swing s) =>
    label.new(
        s.swingLow.myIndex,
        s.swingLow.myLow,
        style = label.style_circle,
        color = bearColor,
        size  = 2,
        yloc  = yloc.belowbar
    )

// Endpoints use extreme-bar coordinates; the drawing is created on completion/interruption.
draw_swing(Swing s, int lineWidth, color lineColor, bool showHighLows) =>
    line s_line = na
    if s.direction == Direction.UP
        s_line := line.new(
            s.swingLow.myIndex,
            s.swingLow.myLow,
            s.swingHigh.myIndex,
            s.swingHigh.myHigh,
            color = lineColor,
            width = lineWidth,
            style = line.style_solid
        )
    if s.direction == Direction.DOWN
        s_line := line.new(
            s.swingHigh.myIndex,
            s.swingHigh.myHigh,
            s.swingLow.myIndex,
            s.swingLow.myLow,
            color = lineColor,
            width = lineWidth,
            style = line.style_solid
        )
    if showHighLows
        draw_swing_high_point(s)
        draw_swing_low_point(s)
    s_line

// Classify against the reference swing. Label placement is not the event availability time.
draw_breakout(Swing s, bool isBreakUp, color lineColor) =>
    if isBreakUp
        lblText = s.direction == Direction.UP ? "BOS" : "CHoCH"
        line.new(
            s.swingHigh.myIndex,
            s.swingHigh.myHigh,
            bar_index,
            s.swingHigh.myHigh,
            width = 1,
            style = line.style_dashed,
            color = isBreakUp ? bullColor : bearColor
        )
        label.new(
            int(math.avg(s.swingHigh.myIndex, bar_index)),
            s.swingHigh.myHigh,
            lblText,
            style     = label.style_label_down,
            color     = color.new(color.black, 100),
            textcolor = bullColor,
            size      = size.small
        )
    else
        lblText = s.direction == Direction.DOWN ? "BOS" : "CHoCH"
        line.new(
            s.swingLow.myIndex,
            s.swingLow.myLow,
            bar_index,
            s.swingLow.myLow,
            width = 1,
            style = line.style_dashed,
            color = isBreakUp ? bullColor : bearColor
        )
        label.new(
            int(math.avg(s.swingLow.myIndex, bar_index)),
            s.swingLow.myLow,
            lblText,
            style     = label.style_label_up,
            color     = color.new(color.black, 100),
            textcolor = bearColor,
            size      = size.small
        )

// =============================================================================
// PRICE SNAPSHOTS AND CEMENT
// =============================================================================
get_point_current() =>
    Point result = Point.new(bar_index, low, high, open, close)
    result

// A bearish Cement closes strictly below every low of the previous N bars.
is_bearish_cemented_candle(int n) =>
    bool isTrue = true
    for i = 1 to n
        isTrue := isTrue and close < low[i]
    isTrue

// A bullish Cement closes strictly above every high of the previous N bars.
is_bullish_cemented_candle(int n) =>
    bool isTrue = true
    for i = 1 to n
        isTrue := isTrue and close > high[i]
    isTrue

// =============================================================================
// FAIR VALUE GAP TRACKING
// =============================================================================
// Detect three-bar gaps without a middle-candle displacement requirement.
get_fvg() =>
    Fvg fvg = na
    if high < low[2]
        fvg := Fvg.new(Direction.DOWN, bar_index - 1, high, low[2])
    if low > high[2]
        fvg := Fvg.new(Direction.UP, bar_index - 1, high[2], low)
    fvg

// Subtract each candle range from stored gaps, trimming or splitting surviving fragments.
check_fvg(Fvg[] fvgArr) =>
    Fvg[] removeArr = array.new<Fvg>()
    Fvg[] addArr    = array.new<Fvg>()
    for fvg in fvgArr
        if high >= fvg.myHigh and low <= fvg.myLow
            removeArr.push(fvg)
        else if low > fvg.myLow and low < fvg.myHigh and high >= fvg.myHigh
            removeArr.push(fvg)
            addArr.push(Fvg.new(fvg.direction, fvg.index, fvg.myLow, low))
        else if high < fvg.myHigh and high > fvg.myLow and low <= fvg.myLow
            removeArr.push(fvg)
            addArr.push(Fvg.new(fvg.direction, fvg.index, high, fvg.myHigh))
        else if high < fvg.myHigh and low > fvg.myLow
            removeArr.push(fvg)
            addArr.push(Fvg.new(fvg.direction, fvg.index, high, fvg.myHigh))
            addArr.push(Fvg.new(fvg.direction, fvg.index, fvg.myLow, low))

    // Apply changes after traversing the original fragments.
    for removeFvg in removeArr
        fvgArr.remove(fvgArr.indexof(removeFvg))
    for addFvg in addArr
        fvgArr.push(addFvg)
    true

// =============================================================================
// PERSISTENT STRUCTURAL STATE
// =============================================================================
var State        currentState      = na
var Swing        currentSwing      = na
var Swing        lastSwing         = na
var CementCandle lastCementCandle  = na
var Point        lastHighPoint     = na
var Point        lastLowPoint      = na
var bool         isComingFromSwing = false
var Fvg[]        fvgArr            = array.new<Fvg>()

// =============================================================================
// DRAWING STORAGE
// =============================================================================
var float[] fiboLevels      = array.new<float>()
var line[]  fiboLines       = array.new<line>()
var label[] fiboLabels      = array.new<label>()
var line[]  swingLimitLines = array.new<line>()
var box[]   fvgBoxes        = array.new<box>()

// At most three boxes, two lines and four labels for the current swing only.
var box premiumBox = na
var box discountBox = na
var box oteBox = na
var line equilibriumLine = na
var line oteReferenceLine = na
var label premiumLabel = na
var label discountLabel = na
var label equilibriumLabel = na
var label oteLabel = na

// =============================================================================
// INITIALIZATION
// =============================================================================
if barstate.isfirst
    pt            = get_point_current()
    lastHighPoint := pt
    lastLowPoint  := pt
    currentSwing  := Swing.new(na, pt, pt)
    currentState  := State.LOOK_FOR_DIRECTION

// Per-execution observations follow Pine rollback on realtime updates.
bool filteredUp = false
bool filteredDown = false
bool acceptedUp = false
bool acceptedDown = false
bool interruptionUp = false

// Evaluate Cement predicates on each execution.
isBullishCem = is_bullish_cemented_candle(i_cementLength)
isBearishCem = is_bearish_cemented_candle(i_cementLength)

// =============================================================================
// INITIAL DIRECTION
// =============================================================================
// The first Cement seeds direction before a mature structural reference exists.
if currentState == State.LOOK_FOR_DIRECTION
    if isBullishCem
        if na(lastCementCandle)
            lastCementCandle       := CementCandle.new(Direction.UP, get_point_current())
            currentSwing.direction := Direction.DOWN
            currentSwing.swingHigh := lastHighPoint
            currentSwing.swingLow  := lastLowPoint
            lastSwing              := currentSwing.copy()
            currentSwing           := Swing.new(Direction.UP, get_point_current(), lastSwing.swingLow)
            lastHighPoint          := get_point_current()
            currentState           := State.LOOK_FOR_SWING
        else
            if lastCementCandle.direction == Direction.DOWN
                if i_showCements
                    draw_cement_point(CementCandle.new(Direction.UP, get_point_current()))
                currentSwing.direction := Direction.DOWN
                currentSwing.swingLow  := lastLowPoint
                currentSwing.swingHigh := lastHighPoint
                draw_swing(currentSwing, i_lineWidth, structureColor, i_showHighLows)
                lastSwing     := currentSwing.copy()
                currentSwing  := Swing.new(Direction.UP, get_point_current(), lastSwing.swingLow)
                lastHighPoint := get_point_current()
                currentState  := State.LOOK_FOR_BREAK
    else if isBearishCem
        if na(lastCementCandle)
            lastCementCandle       := CementCandle.new(Direction.DOWN, get_point_current())
            currentSwing.direction := Direction.UP
            currentSwing.swingLow  := lastLowPoint
            currentSwing.swingHigh := lastHighPoint
            lastSwing              := currentSwing.copy()
            currentSwing           := Swing.new(Direction.DOWN, lastSwing.swingHigh, get_point_current())
            lastLowPoint           := get_point_current()
            currentState           := State.LOOK_FOR_SWING
        else
            if lastCementCandle.direction == Direction.UP
                if i_showCements
                    draw_cement_point(CementCandle.new(Direction.DOWN, get_point_current()))
                currentSwing.direction := Direction.UP
                currentSwing.swingHigh := lastHighPoint
                currentSwing.swingLow  := lastLowPoint
                draw_swing(currentSwing, i_lineWidth, structureColor, i_showHighLows)
                lastSwing    := currentSwing.copy()
                currentSwing := Swing.new(Direction.DOWN, lastSwing.swingHigh, get_point_current())
                lastLowPoint := get_point_current()
                currentState := State.LOOK_FOR_BREAK
    if currentState != State.LOOK_FOR_BREAK
        if high > lastHighPoint.myHigh
            lastHighPoint := get_point_current()
        if low < lastLowPoint.myLow
            lastLowPoint := get_point_current()

// =============================================================================
// IMPULSE TRACKING AND COMPLETION
// =============================================================================
// Opposite boundary breaks take priority over extreme updates and Cement completion.
if currentState == State.LOOK_FOR_SWING
    if currentSwing.direction == Direction.UP
        filteredDown := is_filtered_break(lastSwing, i_breakSource, false)
        if is_break_down(lastSwing, i_breakSource)
            acceptedDown := true
            interruptionUp := false
            isComingFromSwing := true
            currentState      := State.LOOK_FOR_BREAK
        else
            if high > currentSwing.swingHigh.myHigh
                currentSwing.swingHigh := get_point_current()
            if isBearishCem
                if i_showCements
                    draw_cement_point(CementCandle.new(Direction.DOWN, get_point_current()))
                draw_swing(currentSwing, i_lineWidth, structureColor, i_showHighLows)
                lastSwing    := currentSwing.copy()
                lastLowPoint := get_point_current()
                currentState := State.LOOK_FOR_BREAK

    if currentSwing.direction == Direction.DOWN
        filteredUp := is_filtered_break(lastSwing, i_breakSource, true)
        if is_break_up(lastSwing, i_breakSource)
            acceptedUp := true
            interruptionUp := true
            isComingFromSwing := true
            currentState      := State.LOOK_FOR_BREAK
        else
            if low < currentSwing.swingLow.myLow
                currentSwing.swingLow := get_point_current()
            if isBullishCem
                if i_showCements
                    draw_cement_point(CementCandle.new(Direction.UP, get_point_current()))
                draw_swing(currentSwing, i_lineWidth, structureColor, i_showHighLows)
                lastSwing     := currentSwing.copy()
                lastHighPoint := get_point_current()
                currentState  := State.LOOK_FOR_BREAK

// =============================================================================
// STRUCTURAL BREAKS
// =============================================================================
// Keep state blocks and up/down tests sequential: multiple paths may execute on one bar.
if currentState == State.LOOK_FOR_BREAK
    // Finalize the interrupted impulse before classifying the reverse break.
    if isComingFromSwing
        isComingFromSwing := false
        draw_swing(currentSwing, i_lineWidth, structureColor, i_showHighLows)
        lastSwing := currentSwing.copy()
        if lastSwing.direction == Direction.DOWN
            currentSwing := Swing.new(Direction.UP, get_point_current(), lastSwing.swingLow)
        if lastSwing.direction == Direction.UP
            currentSwing := Swing.new(Direction.DOWN, lastSwing.swingHigh, get_point_current())
        if i_showBreaks
            // A copied reference can have a different buffer. Retain the accepted
            // interruption direction in filtered modes; preserve legacy drawing in None.
            draw_breakout(lastSwing, toleranceActive ? interruptionUp : is_break_up(lastSwing, i_breakSource), structureColor)
        currentState := State.LOOK_FOR_SWING
    else
        filteredUp := filteredUp or is_filtered_break(lastSwing, i_breakSource, true)
        filteredDown := filteredDown or is_filtered_break(lastSwing, i_breakSource, false)
        if is_break_up(lastSwing, i_breakSource)
            acceptedUp := true
            if lastSwing.direction == Direction.UP
                draw_swing(
                    Swing.new(Direction.DOWN, lastSwing.swingHigh, lastLowPoint),
                    i_lineWidth,
                    structureColor,
                    false
                )
                currentSwing.direction := Direction.UP
                currentSwing.swingHigh := get_point_current()
                currentSwing.swingLow  := lastLowPoint
            else
                currentSwing.direction := Direction.UP
                currentSwing.swingHigh := get_point_current()
            if i_showBreaks
                draw_breakout(lastSwing, true, structureColor)
            currentState := State.LOOK_FOR_SWING

        if is_break_down(lastSwing, i_breakSource)
            acceptedDown := true
            if lastSwing.direction == Direction.DOWN
                draw_swing(
                    Swing.new(Direction.UP, lastHighPoint, lastSwing.swingLow),
                    i_lineWidth,
                    structureColor,
                    false
                )
                currentSwing.direction := Direction.DOWN
                currentSwing.swingHigh := lastHighPoint
                currentSwing.swingLow  := get_point_current()
            else
                currentSwing.direction := Direction.DOWN
                currentSwing.swingLow  := get_point_current()
            if i_showBreaks
                draw_breakout(lastSwing, false, structureColor)
            currentState := State.LOOK_FOR_SWING
    // Update candidate extremes after break construction to preserve anchor selection.
    if low < lastLowPoint.myLow
        lastLowPoint := get_point_current()
    if high > lastHighPoint.myHigh
        lastHighPoint := get_point_current()

// T denotes a sub-threshold tested crossing, not a liquidity classification.
// Suppress a direction if an accepted break also occurred on this execution.
plotchar(
    i_showFilteredBreaks and filteredUp and not acceptedUp,
    title = "Filtered upward break", char = "T", location = location.abovebar,
    color = equilibriumColor, size = size.tiny, display = display.pane
)
plotchar(
    i_showFilteredBreaks and filteredDown and not acceptedDown,
    title = "Filtered downward break", char = "T", location = location.belowbar,
    color = equilibriumColor, size = size.tiny, display = display.pane
)

// =============================================================================
// FVG MAINTENANCE
// =============================================================================
currentFvg = get_fvg()
if not na(currentFvg)
    fvgArr.push(currentFvg)
check_fvg(fvgArr)

// =============================================================================
// LATEST-BAR DISPLAY
// =============================================================================
// Display boundaries follow currentSwing; break predicates use lastSwing.
if barstate.islast
    // Drawing-only validation: never feeds back into the structural engine.
    bool zonesValid = not na(currentSwing) and not na(currentSwing.swingHigh) and not na(currentSwing.swingLow)
    zonesValid := zonesValid and not na(currentSwing.direction)
    zonesValid := zonesValid and currentSwing.swingLow.myLow > 0 and currentSwing.swingHigh.myHigh > currentSwing.swingLow.myLow

    array.clear(fiboLevels)
    array.push(fiboLevels, 0.0)
    if i_showFiboL2 and not zone_owns_ratio(i_fiboL2, zonesValid)
        array.push(fiboLevels, i_fiboL2)
    if i_showFiboL3 and not zone_owns_ratio(i_fiboL3, zonesValid)
        array.push(fiboLevels, i_fiboL3)
    if i_showFiboL4 and not zone_owns_ratio(i_fiboL4, zonesValid)
        array.push(fiboLevels, i_fiboL4)
    if i_showFiboL5 and not zone_owns_ratio(i_fiboL5, zonesValid)
        array.push(fiboLevels, i_fiboL5)
    if i_showFiboL6 and not zone_owns_ratio(i_fiboL6, zonesValid)
        array.push(fiboLevels, i_fiboL6)
    if i_showFiboL7 and not zone_owns_ratio(i_fiboL7, zonesValid)
        array.push(fiboLevels, i_fiboL7)
    if i_showFiboL8 and not zone_owns_ratio(i_fiboL8, zonesValid)
        array.push(fiboLevels, i_fiboL8)
    if i_showFiboL9 and not zone_owns_ratio(i_fiboL9, zonesValid)
        array.push(fiboLevels, i_fiboL9)
    array.push(fiboLevels, 1.0)

    // Draw only the enabled layers.
    if i_showFibo
        draw_swing_fibo(currentSwing, fiboLines, fiboLabels, fiboLevels, fiboColor, fiboTextColor)
    if i_showCurrentBreakLines
        draw_swing_limit_lines(currentSwing, swingLimitLines, boundaryColor)
    if i_showFvgs
        [fvgRangeHigh, fvgRangeLow] = get_swing_range_double_log(lastSwing)
        draw_fvgs(fvgArr, fvgBoxes, fvgRangeHigh, fvgRangeLow, fvgUpColor, fvgDownColor)

    // Zones extend from the active extreme to the same right edge as the boundaries.
    int zoneRight = bar_index + 10
    int zoneLabelBar = bar_index + 12
    int zoneLeft = bar_index
    float zoneHigh = na
    float zoneLow = na
    float equilibrium = na
    float oteTop = na
    float oteBottom = na
    float oteReference = na
    float premiumLabelPrice = na
    float discountLabelPrice = na
    if zonesValid
        zoneHigh := currentSwing.swingHigh.myHigh
        zoneLow := currentSwing.swingLow.myLow
        zoneLeft := math.max(currentSwing.direction == Direction.UP ? currentSwing.swingHigh.myIndex : currentSwing.swingLow.myIndex, bar_index - 9999)
        equilibrium := get_zone_level(currentSwing, 0.5)
        float ote618 = get_zone_level(currentSwing, 0.618)
        float ote786 = get_zone_level(currentSwing, 0.786)
        oteTop := math.max(ote618, ote786)
        oteBottom := math.min(ote618, ote786)
        oteReference := get_zone_level(currentSwing, i_oteReference == "0.705" ? 0.705 : 0.700)
        // Place PD labels near the outer edges, away from EQ and OTE labels.
        premiumLabelPrice := math.exp(math.log(zoneHigh) - (math.log(zoneHigh) - math.log(zoneLow)) * 0.10)
        discountLabelPrice := math.exp(math.log(zoneLow) + (math.log(zoneHigh) - math.log(zoneLow)) * 0.10)

    if zonesValid and i_showPremiumDiscount
        premiumBox := update_zone_box(premiumBox, zoneLeft, zoneRight, zoneHigh, equilibrium, premiumFillColor)
        discountBox := update_zone_box(discountBox, zoneLeft, zoneRight, equilibrium, zoneLow, discountFillColor)
        premiumLabel := update_zone_label(premiumLabel, zoneLabelBar, premiumLabelPrice, "Premium", zoneTextColor)
        discountLabel := update_zone_label(discountLabel, zoneLabelBar, discountLabelPrice, "Discount", zoneTextColor)
    else
        box.delete(premiumBox)
        box.delete(discountBox)
        label.delete(premiumLabel)
        label.delete(discountLabel)
        premiumBox := na
        discountBox := na
        premiumLabel := na
        discountLabel := na

    // Draw OTE after the subtle PD fills so the band retains its visual emphasis.
    if zonesValid and i_showOTE
        oteBox := update_zone_box(oteBox, zoneLeft, zoneRight, oteTop, oteBottom, oteFillColor)
        string oteText = "OTE 0.618–0.786"
        if i_oteReference != "Off"
            oteText := oteText + "\n" + i_oteReference + " · " + str.tostring(oteReference, format.mintick)
        oteLabel := update_zone_label(oteLabel, zoneLabelBar, math.exp((math.log(oteTop) + math.log(oteBottom)) / 2), oteText, zoneTextColor)
    else
        box.delete(oteBox)
        label.delete(oteLabel)
        oteBox := na
        oteLabel := na

    if zonesValid and i_showOTE and i_oteReference != "Off"
        oteReferenceLine := update_zone_line(oteReferenceLine, zoneLeft, zoneRight, oteReference, oteReferenceColor, line.style_dotted)
    else
        line.delete(oteReferenceLine)
        oteReferenceLine := na

    if zonesValid and i_showEquilibrium
        equilibriumLine := update_zone_line(equilibriumLine, zoneLeft, zoneRight, equilibrium, equilibriumColor, line.style_dashed)
        equilibriumLabel := update_zone_label(equilibriumLabel, zoneLabelBar, equilibrium, "EQ · 0.5\n" + str.tostring(equilibrium, format.mintick), zoneTextColor)
    else
        line.delete(equilibriumLine)
        label.delete(equilibriumLabel)
        equilibriumLine := na
        equilibriumLabel := na
